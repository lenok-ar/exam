#include <iostream>
using namespace std;

int main() {
    int size;

    cout << "Введите размер массива: ";
    cin >> size;

    if (size <= 0) {
        cout << "Массив должен быть положительным" << endl;
        return 1;
    }

    int arr[size], sum=0, product=1;

    cout << "Введите элементы массива:" << endl;
    for (int i = 0; i < size; i++) {
        cout << "Элемент " << i + 1 << ": ";
        cin >> arr[i];

        sum += arr[i];
        product *= arr[i];
    }

    cout << "Сумма элементов массива: " << sum << endl;
    cout << "Произведение элементов массива: " << product << endl;
}
